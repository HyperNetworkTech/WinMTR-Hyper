    EDITTEXT        IDC_EDIT_TIMEOUT_MS,365,68,48,14,ES_AUTOHSCROLL | ES_NUMBER

    LTEXT           "循環次數（0 為不限）：",IDC_OPTIONS_LABEL_CYCLES,15,86,138,11,SS_CENTERIMAGE
    EDITTEXT        IDC_EDIT_CYCLES,158,84,48,14,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "TOS：",IDC_OPTIONS_LABEL_TOS,218,86,140,11,SS_CENTERIMAGE
    EDITTEXT        IDC_EDIT_TOS,365,84,48,14,ES_AUTOHSCROLL | ES_NUMBER

    LTEXT           "資料樣式（-1 為隨機）：",IDC_OPTIONS_LABEL_PATTERN,15,102,138,11,SS_CENTERIMAGE
    EDITTEXT        IDC_EDIT_PATTERN,158,100,48,14,ES_AUTOHSCROLL
    LTEXT           "歷程主機上限：",IDC_OPTIONS_LABEL_HISTORY,218,102,140,11,SS_CENTERIMAGE
    EDITTEXT        IDC_EDIT_HISTORY_LIMIT,365,100,48,14,ES_AUTOHSCROLL | ES_NUMBER

    LTEXT           "起始 TTL：",IDC_OPTIONS_LABEL_START_TTL,15,118,138,11,SS_CENTERIMAGE
    EDITTEXT        IDC_EDIT_START_TTL,158,116,48,14,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "至少探測至 TTL：",IDC_OPTIONS_LABEL_MIN_TTL,218,118,140,11,SS_CENTERIMAGE
    EDITTEXT        IDC_EDIT_MIN_TTL,365,116,48,14,ES_AUTOHSCROLL | ES_NUMBER

    LTEXT           "連續未知上限：",IDC_OPTIONS_LABEL_UNKNOWN,15,134,138,11,SS_CENTERIMAGE
    EDITTEXT        IDC_EDIT_UNKNOWN_LIMIT,158,132,48,14,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "ECMP 顯示上限：",IDC_OPTIONS_LABEL_ECMP,218,134,140,11,SS_CENTERIMAGE
    EDITTEXT        IDC_EDIT_ECMP_LIMIT,365,132,48,14,ES_AUTOHSCROLL | ES_NUMBER

    LTEXT           "回覆快取（秒，0 為停用）：",IDC_OPTIONS_LABEL_REPLY_CACHE,15,150,138,11,SS_CENTERIMAGE
    EDITTEXT        IDC_EDIT_REPLY_CACHE_SECONDS,158,148,48,14,ES_AUTOHSCROLL | ES_NUMBER

    GROUPBOX        "查詢與網路",IDC_OPTIONS_GROUP_NETWORK,7,179,416,43
    CONTROL         "解析主機名稱",IDC_CHECK_RESOLVE_NAMES,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,15,191,95,12
    CONTROL         "查詢 ASN／ISP",IDC_CHECK_LOOKUP_ASN_ISP,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,116,191,105,12
    CONTROL         "禁止分段（DF）",IDC_CHECK_DONT_FRAGMENT,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,235,191,100,12
    CONTROL         "IPv4",IDC_CHECK_IPV4,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,15,207,55,12
    CONTROL         "IPv6",IDC_CHECK_IPV6,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,90,207,55,12
    CONTROL         "啟動時查詢目前公網 IP、地區與業者",IDC_CHECK_QUERY_PUBLIC_INFO,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,166,207,245,12

    PUSHBUTTON      "授權與貢獻者",IDC_BUTTON_LICENSE,7,228,90,18
    PUSHBUTTON      "恢復預設",IDC_BUTTON_RESTORE_DEFAULTS,103,228,75,18
    DEFPUSHBUTTON   "確定",IDOK,299,228,56,18
    PUSHBUTTON      "取消",IDCANCEL,365,228,56,18
END

