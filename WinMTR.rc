/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MENU_COPY_EXPORT MENU
BEGIN
    POPUP "複製／匯出"
    BEGIN
        MENUITEM "複製文字",                    ID_EXPORT_COPY_TEXT
        MENUITEM "複製 HTML",                   ID_EXPORT_COPY_HTML
        MENUITEM SEPARATOR
        MENUITEM "匯出文字…",                   ID_EXPORT_SAVE_TEXT
        MENUITEM "匯出 HTML…",                  ID_EXPORT_SAVE_HTML
        MENUITEM "匯出 CSV…",                   ID_EXPORT_SAVE_CSV
        MENUITEM "匯出 JSON…",                  ID_EXPORT_SAVE_JSON
    END
END


/////////////////////////////////////////////////////////////////////////////
//
// Version
//

VS_VERSION_INFO VERSIONINFO
 FILEVERSION WINMTR_BRAND_FILE_VERSION
 PRODUCTVERSION WINMTR_BRAND_FILE_VERSION
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x4L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040404b0"
        BEGIN
            VALUE "FileDescription", WINMTR_BRAND_PRODUCT_NAME
            VALUE "CompanyName", WINMTR_BRAND_COMPANY_NAME
            VALUE "FileVersion", WINMTR_BRAND_DISPLAY_VERSION
            VALUE "InternalName", "WinMTR"
            VALUE "LegalCopyright", "著作權 © " WINMTR_BRAND_COMPANY_NAME " 與 WinMTR 貢獻者。"
            VALUE "OriginalFilename", "WinMTR.exe"
            VALUE "ProductName", WINMTR_BRAND_PRODUCT_NAME
            VALUE "ProductVersion", WINMTR_BRAND_DISPLAY_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x404, 1200
    END
END


