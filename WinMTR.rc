IDD_DIALOG_OPTIONS DIALOGEX 0, 0, 430, 252
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_VSCROLL | WS_HSCROLL
CAPTION WINMTR_BRAND_OPTIONS_WINDOW_TITLE
FONT 9, WINMTR_BRAND_UI_FONT, 400, 0, 0x88
BEGIN
    GROUPBOX        "",IDC_OPTIONS_GROUP_BRAND,7,7,416,29
    ICON            IDR_MAINFRAME,IDC_OPTIONS_ICON,15,12,18,18
    CTEXT           WINMTR_BRAND_PRODUCT_NAME,IDC_OPTIONS_PRODUCT,42,14,371,14,SS_CENTERIMAGE

    GROUPBOX        "追蹤參數",IDC_OPTIONS_GROUP_TRACE,7,41,416,132
